PORT=5000
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb://localhost:27017/bangal-computer

# CORS — Next.js web app origin
WEB_ORIGIN=http://localhost:3000

# Cloudinary — product image uploads (Part 3)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Payments (Part 6) — leave gateway keys empty in local dev to use the built-in mock checkout
API_PUBLIC_URL=http://localhost:5000
BKASH_BASE_URL=https://tokenized.sandbox.bka.sh/v1.2.0-beta
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=

# Notifications (Part 9) — leave empty in dev to log emails/SMS to the console instead
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@bangalcomputer.com
SMS_API_URL=
SMS_API_KEY=
