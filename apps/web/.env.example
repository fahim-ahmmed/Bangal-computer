# Better Auth
BETTER_AUTH_SECRET=replace-with-a-random-secret
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# MongoDB (Better Auth's own MongoDB adapter connects directly)
MONGODB_URI=mongodb://localhost:27017/bangal-computer

# OAuth — fill in after creating apps in Google/Facebook developer consoles
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# Local Express API. On Vercel Services, set this to /backend/api.
NEXT_PUBLIC_API_URL=http://localhost:5000/api

# SEO — used for sitemap.xml, robots.txt, canonical/OG URLs
NEXT_PUBLIC_SITE_URL=http://localhost:3000
